<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The one ByteScape palette: white surfaces, blue accents, navy text -->
    <Color x:Key="WindowBackgroundColor">#F4F7FB</Color>
    <Color x:Key="LayerColor">#FFFFFF</Color>
    <Color x:Key="LayerAltColor">#EEF3FA</Color>
    <Color x:Key="BorderColorKey">#D9E3F0</Color>
    <Color x:Key="BorderStrongColor">#B7C9E0</Color>
    <Color x:Key="TextColor">#1B2D4B</Color>
    <Color x:Key="TextSecondaryColor">#5C7091</Color>
    <Color x:Key="TextDisabledColor">#A3B2C8</Color>
    <Color x:Key="AccentColor">#1F6FDB</Color>
    <Color x:Key="AccentHoverColor">#3583EE</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="HoverColor">#E6EFFA</Color>
    <Color x:Key="PressedColor">#D4E3F7</Color>
    <Color x:Key="SelectedColor">#DCEAFB</Color>
    <Color x:Key="MapBackgroundColor">#FFFFFF</Color>
    <Color x:Key="SuccessColor">#146C45</Color>
    <Color x:Key="WarningColor">#945500</Color>
    <Color x:Key="ErrorColor">#B8262B</Color>

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="Layer" Color="{StaticResource LayerColor}" />
    <SolidColorBrush x:Key="LayerAlt" Color="{StaticResource LayerAltColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColorKey}" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="Hover" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="Pressed" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="Selected" Color="{StaticResource SelectedColor}" />
    <!-- text on the hover / selected backgrounds (the same navy here; the high contrast palette swaps both, see ThemeManager) -->
    <SolidColorBrush x:Key="HoverText" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SelectedText" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MapBackground" Color="{StaticResource MapBackgroundColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}" />
    <LinearGradientBrush x:Key="ToolbarBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#EEF3FA" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
