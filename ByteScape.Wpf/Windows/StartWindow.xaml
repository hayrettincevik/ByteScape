<Window x:Class="ByteScape.Wpf.Windows.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ByteScape.Wpf.Controls"
        Title="Choose what to scan" Width="640" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Choose what to scan" Style="{StaticResource Title}" />

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="Drives and folders">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="Drives">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" AutomationProperties.Name="Drive or folder to scan" ToolTip="One or more paths separated by ';' — a drive, a folder, an external disk, or a network share (\\server\share)" />
                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
                    </Grid>
                    <ComboBox Grid.Row="2" x:Name="Recent" AutomationProperties.Name="Recent paths" Margin="0,8,0,0" SelectionChanged="Recent_SelectionChanged" />
                </Grid>
            </TabItem>
            <TabItem Header="Snapshots">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource Layer}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <c:Glyph Text="&#xE8E5;" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="Drop a snapshot file here" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" />
                            <TextBlock Text="ByteScape snapshot (*.sns) or Disk Usage output (*.txt)" Style="{StaticResource Secondary}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FileBox" />
                        <Button Grid.Column="1" Content="File…" Margin="8,0,0,0" Click="File_Click" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Start" MinWidth="110" Style="{StaticResource AccentButton}" IsDefault="True" Click="Start_Click" />
        </StackPanel>
    </Grid>
</Window>
