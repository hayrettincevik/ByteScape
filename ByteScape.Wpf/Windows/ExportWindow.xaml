<Window x:Class="ByteScape.Wpf.Windows.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export the view" Width="860" Height="640" MinWidth="640" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Configuration" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox Grid.Column="1" x:Name="Configs" SelectionChanged="Configs_SelectionChanged" />
            <ToggleButton Grid.Column="2" x:Name="DesignToggle" Style="{StaticResource ToolToggle}" Content="&#xE90F;" ToolTip="Design time mode (customize configurations)" Margin="8,0,0,0" Click="Design_Click" />
        </Grid>

        <StackPanel Grid.Row="1" x:Name="DesignTools" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <Button Content="New" Click="New_Click" Margin="0,0,6,0" />
            <Button x:Name="SaveBtn" Content="Save" Click="Save_Click" Margin="0,0,6,0" />
            <Button x:Name="DeleteBtn" Content="Delete" Click="Delete_Click" Margin="0,0,6,0" />
            <Button Content="Import…" Click="Import_Click" Margin="0,0,6,0" />
            <Button x:Name="ExportCfgBtn" Content="Export config…" Click="ExportCfg_Click" />
        </StackPanel>

        <Border Grid.Row="2" x:Name="Design" Visibility="Collapsed" Margin="0,10,0,0" Background="{DynamicResource Layer}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10" Height="250">
            <TabControl x:Name="DesignTabs">
                <TabItem Header="Global">
                    <Grid Margin="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" /><RowDefinition Height="34" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Description" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="Desc" TextChanged="Design_Changed" />
                        <TextBlock Grid.Row="1" Text="Default file name" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" x:Name="FileName" TextChanged="Design_Changed" />
                        <TextBlock Grid.Row="2" Text="File extension filter" VerticalAlignment="Center" ToolTip="e.g. Text files (*.txt)|*.txt" /><TextBox Grid.Row="2" Grid.Column="1" x:Name="FileExt" TextChanged="Design_Changed" />
                        <TextBlock Grid.Row="3" Text="Put first" VerticalAlignment="Center" /><ComboBox Grid.Row="3" Grid.Column="1" x:Name="Block" SelectionChanged="Design_Changed" MinWidth="200" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="4" Text="Then sort by" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                            <ComboBox x:Name="Fine" SelectionChanged="Design_Changed" MinWidth="200" />
                            <CheckBox x:Name="Descending" Content="Descending" Margin="14,0,0,0" Click="Design_Changed" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Header"><TextBox x:Name="Header" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" TextChanged="Design_Changed" VerticalScrollBarVisibility="Auto" /></TabItem>
                <TabItem Header="Detail"><TextBox x:Name="Detail" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" TextChanged="Design_Changed" VerticalScrollBarVisibility="Auto" /></TabItem>
                <TabItem Header="Footer"><TextBox x:Name="Footer" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" TextChanged="Design_Changed" VerticalScrollBarVisibility="Auto" /></TabItem>
                <TabItem Header="Tags &amp; commands">
                    <TextBox IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                             Text="Tags: &lt;%pathfile%&gt; &lt;%path%&gt; &lt;%file%&gt; &lt;%filename%&gt; &lt;%fileext%&gt; &lt;%size%&gt; &lt;%sizebytes%&gt; &lt;%disksize%&gt; &lt;%disksizebytes%&gt;&#10;      &lt;%filecreatedate%&gt; &lt;%filecreatetime%&gt; &lt;%filecreateage%&gt; (also modify / access)&#10;      &lt;%isfile%&gt; &lt;%isfolder%&gt; &lt;%iscontainer%&gt; &lt;%containsfiles%&gt; &lt;%containsfolders%&gt; &lt;%containscontainers%&gt; &lt;%nestinglevel%&gt;&#10;      &lt;%count%&gt; &lt;%localcount%&gt; &lt;%filecount%&gt; &lt;%localfilecount%&gt; &lt;%foldercount%&gt; &lt;%localfoldercount%&gt; &lt;%containercount%&gt; &lt;%localcontainercount%&gt;&#10;&#10;Commands: {&amp;br} {&amp;tab} {&amp;curlyop} {&amp;curlycl} {&amp;angleop} {&amp;anglecl} {script}&#10;          {leftpad{text}{pad}{len}} {rightpad{text}{pad}{len}} {nest{text}}&#10;          {if{a}==|!=|&lt;|&lt;=|&gt;|&gt;={b}?{then}:{else}}" />
                </TabItem>
            </TabControl>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Preview (first elements only)" Style="{StaticResource Secondary}" Margin="0,0,0,4" />
            <Border Background="{DynamicResource Layer}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                <TextBox x:Name="Preview" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="10" />
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="Status" Style="{StaticResource Secondary}" VerticalAlignment="Center" Text="Ready" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" MinWidth="90" Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="ExportBtn" Content="Export…" MinWidth="120" Style="{StaticResource AccentButton}" Click="Export_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
