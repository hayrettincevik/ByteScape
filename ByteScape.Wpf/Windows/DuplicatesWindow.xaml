<Window x:Class="ByteScape.Wpf.Windows.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ByteScape.Wpf.Controls"
        Title="Duplicate files" Width="1120" Height="740" MinWidth="780" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="130" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource LayerAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock x:Name="HeadLine" x:FieldModifier="internal" Style="{StaticResource Subtitle}" Text="Looking for duplicate files…" />
                <TextBlock x:Name="SubLine" x:FieldModifier="internal" Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <ProgressBar x:Name="Progress" x:FieldModifier="internal" Height="6" Maximum="1" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,10,0,6" LastChildFill="False">
            <TextBlock Text="Files from" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="MinSize" x:FieldModifier="internal" MinWidth="90" SelectedIndex="1">
                <ComboBoxItem Content="100 KB" Tag="102400" />
                <ComboBoxItem Content="1 MB" Tag="1048576" />
                <ComboBoxItem Content="10 MB" Tag="10485760" />
                <ComboBoxItem Content="100 MB" Tag="104857600" />
            </ComboBox>
            <CheckBox x:Name="IncludeWindows" x:FieldModifier="internal" Content="Include the Windows folder" Margin="14,0,0,0" VerticalAlignment="Center" />
            <Button Content="Find again" Click="Refresh_Click" Margin="14,0,0,0" ToolTip="Look for duplicates again with these settings" />
            <CheckBox x:Name="Spot" x:FieldModifier="internal" DockPanel.Dock="Right" Content="Highlight on the map" IsChecked="True" VerticalAlignment="Center" Click="Spot_Click" />
        </DockPanel>

        <ListView Grid.Row="2" x:Name="Groups" x:FieldModifier="internal" SelectionMode="Single" SelectionChanged="Groups_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="File" Width="280" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="Copies" Width="60" DisplayMemberBinding="{Binding Count}" />
                    <GridViewColumn Header="Extra space" Width="95" DisplayMemberBinding="{Binding WastedText}" />
                    <GridViewColumn Header="Ticked" Width="60" DisplayMemberBinding="{Binding TickedText}" />
                    <GridViewColumn Header="Folders" Width="480" DisplayMemberBinding="{Binding Folders}" />
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <DockPanel Grid.Row="4">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="Tick all copies but" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Button Content="the oldest" Click="KeepOldest_Click" Margin="0,0,6,0" />
                <Button Content="the newest" Click="KeepNewest_Click" Margin="0,0,6,0" />
                <Button Content="the first by path" Click="KeepFirst_Click" Margin="0,0,6,0" />
                <CheckBox x:Name="EveryGroup" x:FieldModifier="internal" Content="in every group" VerticalAlignment="Center" Margin="6,0,0,0" />
                <Button Content="Untick all" Click="Untick_Click" Margin="14,0,0,0" />
            </WrapPanel>
            <ListView x:Name="Copies" x:FieldModifier="internal" SelectionMode="Single" MouseDoubleClick="Copies_MouseDoubleClick">
                <ListView.Resources>
                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" /></Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="34">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding CanDelete}" ToolTip="{Binding Verdict}" AutomationProperties.Name="{Binding Path}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Copy" Width="520" DisplayMemberBinding="{Binding Path}" />
                        <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedText}" />
                        <GridViewColumn Header="Safe to delete?" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold" ToolTip="{Binding Verdict}">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground"><Setter.Value><MultiBinding Converter="{x:Static c:A11y.Tone}"><Binding Path="LevelBrush" /><Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ListViewItem}" /></MultiBinding></Setter.Value></Setter></Style></TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Note" Width="260" DisplayMemberBinding="{Binding Note}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <c:FooterPanel Grid.Row="5" Margin="0,10,0,0">
            <WrapPanel Margin="12,0,0,0">
                <Button Content="Show on map" Click="ShowOnMap_Click" Margin="0,0,8,0" />
                <Button Content="Open in Explorer" Click="Explorer_Click" Margin="0,0,8,0" />
                <Button x:Name="RecycleBtn" x:FieldModifier="internal" Style="{StaticResource AccentButton}" Content="Move ticked to the Recycle Bin…" Padding="12,4" Click="Recycle_Click" Margin="0,0,8,0" />
                <Button x:Name="ForeverBtn" x:FieldModifier="internal" Content="Delete ticked permanently…" Click="Forever_Click" Margin="0,0,8,0" />
                <Button Content="Save list…" Click="Save_Click" Margin="0,0,8,0" ToolTip="Text, CSV or JSON by the file name you choose" />
                <Button Content="Close" Click="Close_Click" MinWidth="80" />
            </WrapPanel>
            <TextBlock x:Name="SelectionText" x:FieldModifier="internal" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </c:FooterPanel>
    </Grid>
</Window>
