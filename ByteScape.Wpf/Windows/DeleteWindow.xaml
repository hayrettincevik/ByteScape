<Window x:Class="ByteScape.Wpf.Windows.DeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ByteScape.Wpf.Controls"
        Title="Delete" Width="780" Height="640" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadLine" x:FieldModifier="internal" Style="{StaticResource Subtitle}" TextWrapping="Wrap" Text="Looking at what would be deleted…" />
            <TextBlock x:Name="SubLine" x:FieldModifier="internal" Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="HowPanel" Grid.Row="1" Margin="0,12,0,0">
            <RadioButton x:Name="RecycleOpt" x:FieldModifier="internal" GroupName="How" Checked="How_Changed">
                <StackPanel>
                    <TextBlock Text="Move to the Recycle Bin" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Text="Can be restored from the Recycle Bin. The space is freed only when the Recycle Bin is emptied." />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ForeverOpt" x:FieldModifier="internal" GroupName="How" Checked="How_Changed" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Delete permanently" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Text="Cannot be undone. The space is freed at once." />
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <Border x:Name="NoteBox" x:FieldModifier="internal" Grid.Row="2" Margin="0,10,0,0" Padding="10,6" CornerRadius="4" Background="#FFF6E5" BorderBrush="#F0D39A" BorderThickness="1" Visibility="Collapsed">
            <TextBlock x:Name="NoteText" x:FieldModifier="internal" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" />
        </Border>

        <ScrollViewer Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <StackPanel x:Name="ItemsPanel" x:FieldModifier="internal" Margin="8" />
        </ScrollViewer>

        <Border x:Name="AdminBox" x:FieldModifier="internal" Grid.Row="4" Margin="0,10,0,0" Padding="10,6" CornerRadius="4" Background="#FFF6E5" BorderBrush="#F0D39A" BorderThickness="1" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="ElevateBtn" x:FieldModifier="internal" DockPanel.Dock="Right" Content="Restart as administrator" Margin="10,0,0,0" VerticalAlignment="Center" Click="Elevate_Click"
                        ToolTip="Starts ByteScape again as administrator with the same views (the scan is kept); then delete again" />
                <TextBlock x:Name="AdminText" x:FieldModifier="internal" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <CheckBox x:Name="Understand" x:FieldModifier="internal" Grid.Row="5" Margin="0,10,0,0" Visibility="Collapsed" Checked="Understand_Changed" Unchecked="Understand_Changed">
            <TextBlock x:Name="UnderstandText" x:FieldModifier="internal" TextWrapping="Wrap" />
        </CheckBox>

        <StackPanel x:Name="ProgressPanel" x:FieldModifier="internal" Grid.Row="6" Margin="0,10,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="Progress" x:FieldModifier="internal" Height="6" Maximum="1" />
            <TextBlock x:Name="ProgressText" x:FieldModifier="internal" Style="{StaticResource Secondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <c:FooterPanel Grid.Row="7" Margin="0,12,0,0">
            <WrapPanel>
                <Button x:Name="DeleteBtn" x:FieldModifier="internal" Style="{StaticResource AccentButton}" Content="Move to the Recycle Bin" Padding="16,5" Margin="0,0,8,0" IsEnabled="False" Click="Delete_Click" />
                <Button x:Name="CancelBtn" x:FieldModifier="internal" Content="Cancel" MinWidth="90" IsCancel="True" Click="Cancel_Click" />
            </WrapPanel>
            <TextBlock x:Name="CheckText" x:FieldModifier="internal" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </c:FooterPanel>
    </Grid>
</Window>
