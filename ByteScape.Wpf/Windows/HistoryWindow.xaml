<Window x:Class="ByteScape.Wpf.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ByteScape.Wpf.Controls"
        Title="Disk usage history" Width="1160" Height="780" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadLine" x:FieldModifier="internal" Style="{StaticResource Subtitle}" TextWrapping="Wrap" />
            <TextBlock x:Name="SubLine" x:FieldModifier="internal" Style="{StaticResource Secondary}" Margin="0,4,0,8" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource Layer}" Padding="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Used space of the drive" Style="{StaticResource Secondary}" Margin="4,0,0,2" />
                <Canvas x:Name="DriveChart" x:FieldModifier="internal" ClipToBounds="True" SizeChanged="Chart_SizeChanged" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                    <ComboBox x:Name="Depth" x:FieldModifier="internal" AutomationProperties.Name="Folder levels" DockPanel.Dock="Right" MinWidth="120" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="all levels" Tag="9" />
                        <ComboBoxItem Content="first level" Tag="1" />
                        <ComboBoxItem Content="two levels" Tag="2" />
                    </ComboBox>
                    <TextBox x:Name="Search" x:FieldModifier="internal" AutomationProperties.Name="Search" TextChanged="Filter_Changed" ToolTip="Folder name or path" />
                </DockPanel>
                <ListView x:Name="List" x:FieldModifier="internal" SelectionMode="Extended" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Folder" Width="230" DisplayMemberBinding="{Binding Path}" />
                            <GridViewColumn Header="First" Width="72" DisplayMemberBinding="{Binding FirstText}" />
                            <GridViewColumn Header="Last" Width="72" DisplayMemberBinding="{Binding LastText}" />
                            <GridViewColumn Header="Change" Width="80" DisplayMemberBinding="{Binding ChangeText}" />
                            <GridViewColumn Header="Trend" Width="92">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Polyline Points="{Binding Spark}" Stroke="{Binding SparkBrush}" StrokeThickness="1.5" Width="80" Height="18" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource Layer}" Padding="6">
                    <DockPanel>
                        <TextBlock x:Name="FolderChartTitle" x:FieldModifier="internal" DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="4,0,0,2" Text="Selected folders over time (select up to 6)" />
                        <WrapPanel x:Name="Legend" x:FieldModifier="internal" DockPanel.Dock="Bottom" Margin="4,2,0,0" />
                        <Canvas x:Name="FolderChart" x:FieldModifier="internal" ClipToBounds="True" SizeChanged="Chart_SizeChanged" />
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource Layer}" Padding="6">
                    <DockPanel>
                        <TextBlock x:Name="ChangeTitle" x:FieldModifier="internal" DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="4,0,0,2" Text="Biggest changes" />
                        <Canvas x:Name="ChangeChart" x:FieldModifier="internal" ClipToBounds="True" SizeChanged="Chart_SizeChanged" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <c:FooterPanel Grid.Row="3" Margin="0,10,0,0">
            <WrapPanel>
                <Button Content="Show on map" Click="ShowOnMap_Click" Margin="0,0,8,0" />
                <Button Content="Save as CSV…" Click="Save_Click" Margin="0,0,8,0" ToolTip="One row per folder, one column per scan" />
                <Button Content="Close" Click="Close_Click" MinWidth="80" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Each complete scan of the whole drive remembers its folders of 50 MB and more (three levels deep); the drive line comes from the free space measurements." />
        </c:FooterPanel>
    </Grid>
</Window>
