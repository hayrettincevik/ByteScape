<Window x:Class="ByteScape.Wpf.Windows.DevWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ByteScape.Wpf.Controls"
        Title="Developer leftovers" Width="1100" Height="700" MinWidth="760" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- summary -->
        <Border Background="{DynamicResource LayerAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeadLine" x:FieldModifier="internal" Style="{StaticResource Subtitle}" />
                    <TextBlock x:Name="SubLine" Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="PartialLine" Foreground="{DynamicResource Warning}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <StackPanel Margin="0,0,18,0" ToolTip="Projects with no change for more than six months, and what their tools would rebuild"><TextBlock Text="Untouched for 6 months" Style="{StaticResource Secondary}" /><TextBlock x:Name="StaleText" x:FieldModifier="internal" FontSize="16" Foreground="{DynamicResource Warning}" /></StackPanel>
                    <StackPanel Margin="0,0,18,0" ToolTip="All node_modules folders"><TextBlock Text="node_modules" Style="{StaticResource Secondary}" /><TextBlock x:Name="NodeText" FontSize="16" /></StackPanel>
                    <StackPanel ToolTip="Folders whose rebuild may not give the same result (no lock file, no requirements file)"><TextBlock Text="Check first" Style="{StaticResource Secondary}" /><TextBlock x:Name="WarnText" FontSize="16" /></StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- tools -->
        <DockPanel Grid.Row="1" Margin="0,10,0,6" LastChildFill="False">
            <c:Glyph Text="&#xE721;" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondary}" />
            <TextBox x:Name="Search" x:FieldModifier="internal" AutomationProperties.Name="Search" Width="200" VerticalAlignment="Center" TextChanged="Search_TextChanged" ToolTip="Project, kind or folder" />
            <TextBlock Text="Untouched for" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="18,0,6,0" />
            <ComboBox x:Name="Stale" x:FieldModifier="internal" MinWidth="110" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="any time" Tag="0" />
                <ComboBoxItem Content="1 month" Tag="30" />
                <ComboBoxItem Content="3 months" Tag="91" />
                <ComboBoxItem Content="6 months" Tag="182" />
                <ComboBoxItem Content="1 year" Tag="365" />
                <ComboBoxItem Content="2 years" Tag="730" />
            </ComboBox>
            <CheckBox x:Name="Spot" x:FieldModifier="internal" Content="Highlight on the map" IsChecked="True" Margin="18,0,0,0" VerticalAlignment="Center" Click="Spot_Click" />
            <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" ToolTip="Look for projects again" />
        </DockPanel>

        <ListView Grid.Row="2" x:Name="ProjectList" x:FieldModifier="internal" SelectionMode="Single" SelectionChanged="ProjectList_SelectionChanged" MouseDoubleClick="ProjectList_MouseDoubleClick">
            <ListView.Resources>
                <!-- the application's TextBlock style fixes the colour: cells take it from their row (or header) instead -->
                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" /></Style>
            </ListView.Resources>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Project" Width="210" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Kind" Width="130" DisplayMemberBinding="{Binding Kinds}" />
                    <GridViewColumn Header="Rebuildable" Width="95" DisplayMemberBinding="{Binding ArtifactText}" />
                    <GridViewColumn Header="Sources" Width="85" DisplayMemberBinding="{Binding SourceText}" />
                    <GridViewColumn Header="Last change" Width="115" DisplayMemberBinding="{Binding ChangedText}" />
                    <GridViewColumn Header="Folder" Width="400" DisplayMemberBinding="{Binding Path}" />
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <DockPanel Grid.Row="4">
            <TextBlock x:Name="PieceHead" x:FieldModifier="internal" DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="0,2,0,4" TextTrimming="CharacterEllipsis" />
            <ListView x:Name="PieceList" x:FieldModifier="internal" SelectionMode="Extended" MouseDoubleClick="PieceList_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Folder" Width="300" DisplayMemberBinding="{Binding Folder}" />
                        <GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding SizeText}" />
                        <GridViewColumn Header="Rebuilt by" Width="300" DisplayMemberBinding="{Binding Rebuild}" />
                        <GridViewColumn Header="Note" Width="330" DisplayMemberBinding="{Binding Note}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>

        <c:FooterPanel Grid.Row="5" Margin="0,10,0,0">
            <WrapPanel Margin="12,0,0,0">
                <Button Content="Show on map" Click="ShowOnMap_Click" Margin="0,0,8,0" />
                <Button x:Name="ExplorerBtn" Content="Open in Explorer" Click="Explorer_Click" Margin="0,0,8,0" />
                <Button x:Name="DeleteBtn" x:FieldModifier="internal" Content="Move to the Recycle Bin…" Click="Delete_Click" Margin="0,0,8,0"
                        ToolTip="The selected folders (all of the project's when none is selected) go through the delete dialog: what goes, whether it is safe, what is open in a program" />
                <Button x:Name="CommandsBtn" x:FieldModifier="internal" Content="Copy delete commands" Click="Commands_Click" Margin="0,0,8,0"
                        ToolTip="PowerShell lines that delete the selected folders (all of the project's when none is selected), each with the command that rebuilds it" />
                <Button Content="Copy list" Click="Copy_Click" Margin="0,0,8,0" />
                <Button Content="Save as text…" Click="Save_Click" Margin="0,0,8,0" />
                <Button Content="Close" Click="Close_Click" MinWidth="90" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="The tools rebuild these folders. Close the editor first; deleting goes to the Recycle Bin, or run the copied lines yourself." />
        </c:FooterPanel>
    </Grid>
</Window>
