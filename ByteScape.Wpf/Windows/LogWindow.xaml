<Window x:Class="ByteScape.Wpf.Windows.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log console" Width="820" Height="340" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <ToggleButton x:Name="AutoPopup" Style="{StaticResource ToolToggle}" Content="&#xE945;" IsChecked="True" ToolTip="Auto popup on events (turn off to stop the console from appearing)" Click="AutoPopup_Click" Width="Auto" Padding="10,0" />
            <TextBlock Text="Auto popup" VerticalAlignment="Center" Margin="4,0,14,0" />
            <Button Content="Clear" Click="Clear_Click" Margin="0,0,6,0" />
            <Button Content="Copy" Click="Copy_Click" />
        </StackPanel>
        <ListView Grid.Row="1" x:Name="List">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" Width="80" DisplayMemberBinding="{Binding Time, StringFormat=HH:mm:ss}" />
                    <GridViewColumn Header="Level" Width="70" DisplayMemberBinding="{Binding LevelText}" />
                    <GridViewColumn Header="Message" Width="620" DisplayMemberBinding="{Binding Message}" />
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Grid.Row="2" Style="{StaticResource Secondary}" Margin="0,8,0,0" Text="HINT: run as Administrator if folders are not accessible" />
    </Grid>
</Window>
