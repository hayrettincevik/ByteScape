<Window x:Class="ByteScape.Wpf.Windows.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ByteScape.Wpf.Controls"
        Title="Cleanup" Width="1120" Height="740" MinWidth="780" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="110" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- summary -->
        <Border Background="{DynamicResource LayerAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock x:Name="HeadLine" x:FieldModifier="internal" Style="{StaticResource Subtitle}" />
                <TextBlock x:Name="SubLine" x:FieldModifier="internal" Style="{StaticResource Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="PartialLine" Foreground="{DynamicResource Warning}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
            <TabControl x:Name="Tabs" x:FieldModifier="internal" SelectionChanged="Tabs_SelectionChanged" BorderThickness="0" Padding="0">
                <TabItem x:Name="TabLarge" x:FieldModifier="internal" Header="Large files" Tag="LargeFiles" />
                <TabItem x:Name="TabTemp" x:FieldModifier="internal" Header="Temporary files" Tag="TemporaryFiles" />
                <TabItem x:Name="TabInstallers" x:FieldModifier="internal" Header="Old installation files" Tag="OldInstallers" />
                <TabItem x:Name="TabPrograms" x:FieldModifier="internal" Header="Unused programs" Tag="UnusedPrograms" />
            </TabControl>
            <CheckBox x:Name="Spot" x:FieldModifier="internal" DockPanel.Dock="Right" Content="Highlight on the map" IsChecked="True" VerticalAlignment="Center" Click="Spot_Click" />
        </DockPanel>

        <ListView Grid.Row="2" x:Name="List" x:FieldModifier="internal" SelectionMode="Single" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" Margin="0,4,0,0">
            <ListView.Resources>
                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" /></Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" IsEnabled="{Binding CanDelete}" ToolTip="{Binding CheckTip}" AutomationProperties.Name="{Binding Name}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="Safe to delete?" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LevelText}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"><Setter Property="Foreground"><Setter.Value><MultiBinding Converter="{x:Static c:A11y.Tone}"><Binding Path="LevelBrush" /><Binding Path="Foreground" RelativeSource="{RelativeSource AncestorType=ListViewItem}" /></MultiBinding></Setter.Value></Setter></Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="When" Width="190" DisplayMemberBinding="{Binding WhenText}" />
                    <GridViewColumn Header="Where / what" Width="400" DisplayMemberBinding="{Binding Where}" />
                </GridView>
            </ListView.View>
        </ListView>

        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

        <Border Grid.Row="4" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="10">
            <DockPanel>
                <WrapPanel x:Name="ActionPanel" x:FieldModifier="internal" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="ShowBtn" Content="Show on map" Click="ShowOnMap_Click" Margin="0,0,8,0" />
                    <Button x:Name="ExplorerBtn" Content="Open in Explorer" Click="Explorer_Click" Margin="0,0,8,0" />
                    <Button x:Name="WindowsBtn" x:FieldModifier="internal" Click="WindowsAction_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="UsesBtn" x:FieldModifier="internal" Content="Everything it uses" Click="Uses_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                </WrapPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" x:FieldModifier="internal" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <c:FooterPanel Grid.Row="5" Margin="0,10,0,0">
            <WrapPanel Margin="12,0,0,0">
                <Button Content="Select safe" Click="SelectSafe_Click" Margin="0,0,8,0" ToolTip="Tick every item marked Safe in this list" />
                <Button Content="Select none" Click="SelectNone_Click" Margin="0,0,8,0" />
                <Button x:Name="RecycleBtn" x:FieldModifier="internal" Style="{StaticResource AccentButton}" Content="Move to the Recycle Bin…" Padding="12,4" Click="Recycle_Click" Margin="0,0,8,0" />
                <Button x:Name="ForeverBtn" x:FieldModifier="internal" Content="Delete permanently…" Click="Forever_Click" Margin="0,0,8,0" />
                <Button Content="Copy list" Click="Copy_Click" Margin="0,0,8,0" />
                <Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0" />
                <Button Content="Close" Click="Close_Click" MinWidth="80" />
            </WrapPanel>
            <TextBlock x:Name="SelectionText" x:FieldModifier="internal" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </c:FooterPanel>
    </Grid>
</Window>
