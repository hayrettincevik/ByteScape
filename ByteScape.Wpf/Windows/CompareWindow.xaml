<Window x:Class="ByteScape.Wpf.Windows.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ByteScape.Wpf.Controls"
        Title="Compare with snapshot" Width="980" Height="620" MinWidth="700" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- summary -->
        <Border Background="{DynamicResource LayerAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeadLine" Style="{StaticResource Subtitle}" />
                    <TextBlock x:Name="BaselineLine" Style="{StaticResource Secondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CurrentLine" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <StackPanel Margin="0,0,18,0"><TextBlock Text="Grown / added" Style="{StaticResource Secondary}" /><TextBlock x:Name="GrownText" FontSize="16" Foreground="{DynamicResource Error}" /></StackPanel>
                    <StackPanel Margin="0,0,18,0"><TextBlock Text="Shrunk / removed" Style="{StaticResource Secondary}" /><TextBlock x:Name="ShrunkText" FontSize="16" Foreground="{DynamicResource Success}" /></StackPanel>
                    <StackPanel><TextBlock Text="Net change" Style="{StaticResource Secondary}" /><TextBlock x:Name="NetText" FontSize="16" FontWeight="SemiBold" /></StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- filters -->
        <WrapPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
            <CheckBox x:Name="ShowGrown" Content="Grown" IsChecked="True" Margin="0,0,12,0" Click="Filter_Click" />
            <CheckBox x:Name="ShowShrunk" Content="Shrunk" IsChecked="True" Margin="0,0,12,0" Click="Filter_Click" />
            <CheckBox x:Name="ShowAdded" Content="Added" IsChecked="True" Margin="0,0,12,0" Click="Filter_Click" />
            <CheckBox x:Name="ShowRemoved" Content="Removed" IsChecked="True" Margin="0,0,24,0" Click="Filter_Click" />
            <CheckBox x:Name="ShowFolders" Content="Folders" IsChecked="True" Margin="0,0,12,0" Click="Filter_Click" />
            <CheckBox x:Name="ShowFiles" Content="Files" IsChecked="True" Margin="0,0,24,0" Click="Filter_Click" />
            <TextBlock Text="Min change" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Secondary}" />
            <ComboBox x:Name="MinChange" MinWidth="90" SelectedIndex="1" SelectionChanged="Filter_Click">
                <ComboBoxItem Content="any" Tag="0" />
                <ComboBoxItem Content="1 MB" Tag="1048576" />
                <ComboBoxItem Content="10 MB" Tag="10485760" />
                <ComboBoxItem Content="100 MB" Tag="104857600" />
                <ComboBoxItem Content="1 GB" Tag="1073741824" />
            </ComboBox>
            <CheckBox x:Name="Overlay" Content="Highlight changes on the map" IsChecked="True" Margin="24,0,0,0" Click="Overlay_Click" />
        </WrapPanel>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="CountText" Style="{StaticResource Secondary}" Margin="0,8,0,4" />
            <Border x:Name="SummaryBox" Visibility="Collapsed" Background="{DynamicResource LayerAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                    <TextBlock Text="Written by the local model you configured from the numbers above; may be wrong." Style="{StaticResource Secondary}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ListView Grid.Row="3" x:Name="List" x:FieldModifier="internal" MouseDoubleClick="List_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Change" Width="80" DisplayMemberBinding="{Binding KindText}" />
                    <GridViewColumn Header="Δ" Width="90" DisplayMemberBinding="{Binding DeltaText}" />
                    <GridViewColumn Header="Before" Width="80" DisplayMemberBinding="{Binding OldText}" />
                    <GridViewColumn Header="After" Width="80" DisplayMemberBinding="{Binding NewText}" />
                    <GridViewColumn Header="Type" Width="55" DisplayMemberBinding="{Binding TypeText}" />
                    <GridViewColumn Header="Path" Width="520" DisplayMemberBinding="{Binding Path}" />
                </GridView>
            </ListView.View>
        </ListView>

        <c:FooterPanel Grid.Row="4" Margin="0,10,0,0">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="SummarizeBtn" Content="Summarize with local model" Click="Summarize_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                <Button Content="Copy list" Click="Copy_Click" Margin="0,0,8,0" />
                <Button Content="Save as text…" Click="Save_Click" Margin="0,0,8,0" />
                <Button Content="Close" Click="Close_Click" MinWidth="90" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" Text="Double click a row to show it on the map. Removed items no longer exist and cannot be shown." />
        </c:FooterPanel>
    </Grid>
</Window>
