<Window x:Class="ByteScape.Wpf.Windows.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ByteScape.Wpf.Controls"
        Title="Help" Width="760" Height="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource Title}" Margin="0,0,0,10" />
        <Border Grid.Row="1" Background="{DynamicResource Layer}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer>
                <TextBox x:Name="Body" AutomationProperties.LabeledBy="{Binding ElementName=Heading}" AutomationProperties.Name="{Binding Text, ElementName=Heading}" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextWrapping="NoWrap" Padding="12" />
            </ScrollViewer>
        </Border>
        <Button Grid.Row="2" Content="Close" MinWidth="100" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True" />
    </Grid>
</Window>
