<UserControl x:Class="ByteScape.Wpf.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ByteScape.Wpf.Controls"
             Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- breadcrumb + filter -->
        <Grid Grid.Row="0" Margin="10,6,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Layer}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="4,0" MinHeight="32">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Breadcrumb" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" Margin="8,0,0,0" Width="340">
                <TextBox x:Name="FilterBox" Padding="30,5,8,5" AutomationProperties.Name="Filter" ToolTip="Filter: *.jpg;&gt;100kb;&lt;6months;:red;:attr:h;:reclaimable;\temp  (| negates) — Enter applies.&#10;Plain language works too: “6 aydır açılmamış 100 MB üstü videolar”, “large files except videos”" />
                <Button x:Name="FilterPresets" x:FieldModifier="internal" Content="&#xE71C;" Style="{StaticResource ToolButton}" Width="26" Height="26" FontSize="14" HorizontalAlignment="Left" Margin="3,0,0,0"
                        ToolTip="Ready-made filters: file types, sizes, ages (they are added to what is typed)" Click="FilterPresets_Click" />
                <Button x:Name="FilterClear" Content="&#xE894;" Style="{StaticResource ToolButton}" Width="26" Height="26" FontSize="11" HorizontalAlignment="Right" Margin="0,0,3,0" ToolTip="Clear filter" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- map + details -->
        <Grid Grid.Row="1" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <!-- viewable percent bar -->
            <Border Background="{DynamicResource Layer}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="3" Margin="0,0,4,0" ToolTip="Portion of the media shown in the current zoom">
                <Grid>
                    <Rectangle x:Name="PercentFill" Fill="{DynamicResource Accent}" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2" Margin="1" Height="0" />
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <c:TreemapView x:Name="Map" />
                    <Popup x:Name="Tip" AllowsTransparency="True" Placement="Relative" PlacementTarget="{Binding ElementName=Map}" IsHitTestVisible="False" PopupAnimation="None">
                        <Border Background="{DynamicResource Layer}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" CornerRadius="4" Padding="10,7" MaxWidth="420">
                            <StackPanel>
                                <TextBlock x:Name="TipTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TipBody" Style="{StaticResource Secondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <!-- details side panel -->
            <Border Grid.Column="2" x:Name="DetailsPanel" Margin="8,0,0,0" Background="{DynamicResource Layer}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetName" Style="{StaticResource Subtitle}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" Text="Nothing selected" />
                    <TextBlock Grid.Row="1" x:Name="DetPath" Style="{StaticResource Secondary}" TextWrapping="Wrap" FontSize="11" />
                    <StackPanel Grid.Row="2" x:Name="DetFacts" Margin="0,10,0,0" />
                    <DockPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Largest contents" Style="{StaticResource Secondary}" Margin="0,0,0,4" />
                        <ListView x:Name="DetChildren" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}" />
                                    <GridViewColumn Header="%" Width="45" DisplayMemberBinding="{Binding Percent}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- status -->
        <Grid Grid.Row="2" Margin="10,6,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ready" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CloudText" Style="{StaticResource TextLink}" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" Click="CloudText_Click" />
                <Button x:Name="ReclaimText" Style="{StaticResource TextLink}" VerticalAlignment="Center" Margin="12,0" Visibility="Collapsed" Click="ReclaimText_Click" />
            </StackPanel>
            <TextBlock Grid.Column="2" x:Name="ProgressText" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,0" />
            <ProgressBar Grid.Column="3" x:Name="Progress" Width="160" VerticalAlignment="Center" Minimum="0" Maximum="1000" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
