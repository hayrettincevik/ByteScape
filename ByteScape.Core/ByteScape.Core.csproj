<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ByteScape</RootNamespace>
    <AssemblyName>ByteScape.Core</AssemblyName>
    <Version>1.0.0</Version>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- translation catalogs: ByteScape.Core.Localization.<code>.txt -->
    <EmbeddedResource Include="Core\Localization\*.txt" LogicalName="ByteScape.Core.Localization.%(Filename).txt" />
    <!-- the licence (the repository's LICENSE file) and the third-party notices: ByteScape.Core.Legal.<file> -->
    <EmbeddedResource Include="..\LICENSE" LogicalName="ByteScape.Core.Legal.LICENSE.txt" WithCulture="false" />
    <EmbeddedResource Include="Core\Legal\*.txt" LogicalName="ByteScape.Core.Legal.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ByteScape.Tests" />
    <InternalsVisibleTo Include="ByteScape" />
    <InternalsVisibleTo Include="ByteScape.Wpf" />
    <InternalsVisibleTo Include="ByteScape.Diag" />
  </ItemGroup>

</Project>
